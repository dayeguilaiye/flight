# Runtime data: mount this directory in Docker/Kubernetes instead of committing it.
data/*
!data/.gitkeep

# Frontend dependencies and generated assets.
frontend/node_modules/
frontend/dist/

# Go embed target generated by the frontend build.
internal/web/dist/*
!internal/web/dist/.gitkeep

# Release binaries and local deployment credentials.
build/
.env
.env.*
*.kubeconfig
